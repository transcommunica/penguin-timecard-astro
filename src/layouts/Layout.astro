---
import '../styles/styles.css';
import SiteJsonLd from '../components/SiteJsonLd.astro';

interface Props {
	title?: string;
	description?: string;
	/** 正規URL。省略時は現在のパス（クエリパラメータを除いたもの）。 */
	canonical?: string;
	/** true でこのページを検索結果から除外する。 */
	noindex?: boolean;
	/** og:type。記事ページは 'article'。 */
	ogType?: 'website' | 'article';
	/** OGP画像のパス。省略時は共通のOG画像。 */
	ogImage?: string;
	/** article:published_time（ISO文字列）。記事ページのみ。 */
	publishedTime?: string;
}

const {
	title = 'ペンギンタイムカード — インストールしたその日から使える、やさしい勤怠管理',
	description = '小さなお店・会社のための、インストール不要のやさしい勤怠管理アプリ。ICカードも機械も不要。今すぐ無料で始められます。',
	canonical,
	noindex = false,
	ogType = 'website',
	ogImage = '/assets/og-image.png',
	publishedTime,
} = Astro.props;

// Astro.url.pathname だけを使うことで ?from=home / ?page=2 のような
// クエリ付きURLでも正規URLが1本に収束する。
const FONT_HREF =
	'https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700;800;900&family=JetBrains+Mono:wght@700;800&display=swap';

const canonicalHref = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
// OGPの画像・URLは絶対URLでなければクローラが解決できない。
const ogImageHref = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalHref} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="ペンギンタイムカード" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:image" content={ogImageHref} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="ペンギンタイムカード — むずかしくないタイムカードを。" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageHref} />
		<script is:inline>
			(function () {
				try {
					if (new URLSearchParams(window.location.search).get('noheader') === '1') {
						document.documentElement.classList.add('noheader');
					}
				} catch (e) {}
			})();
		</script>
		<link rel="icon" href="/favicon.ico" />
		{/*
		  機械可読な入口の明示。
		  - RSS: 新着の発見経路。アグリゲータや監視ツールが実際に読む。
		  - llms.txt: llmstxt.org の目次。検索エンジンは読まないが、
		    人がAIエージェントにこのサイトを読ませるときの入口になる。
		*/}
		<link rel="alternate" type="application/rss+xml" title="お知らせ | ペンギンタイムカード" href="/rss.xml" />
		<link rel="describedby" type="text/plain" href="/llms.txt" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{/*
		  Webフォントの読み込み。
		  - Noto Sans JP は日本語のため1ウェイトあたりの容量が大きい。実際に使っている
		    500（本文）/700/800/900 だけを読み込む（400は未使用だったため除外）。
		  - JetBrains Mono は数字とラベルにのみ使用。最大ウェイトは800。
		  - media="print" → onload で all に切り替えることで、描画をブロックしないようにする。
		    JavaScript が無効な環境向けに noscript で通常の stylesheet を用意している。
		*/}
		<link rel="preload" as="style" href={FONT_HREF} />
		<link rel="stylesheet" href={FONT_HREF} media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href={FONT_HREF} /></noscript>
		<style>
			/* tweak-driven utility classes */
			html.hide-mascot .mascot { display: none !important; }
			html.reduce-motion *, html.reduce-motion *::before, html.reduce-motion *::after {
				animation-duration: 0.001ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.001ms !important;
			}
		</style>
		<!-- サイト共通の構造化データ（Organization / WebSite） -->
		<SiteJsonLd />
		<!-- ページ固有の head 要素（rel=prev/next、構造化データなど） -->
		<slot name="head" />
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-NZ5W1S0PZV"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-NZ5W1S0PZV');
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
