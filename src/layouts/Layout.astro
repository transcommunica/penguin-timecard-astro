---
import '../styles/styles.css';

interface Props {
	title?: string;
	description?: string;
	/** 正規URL。省略時は現在のパス（クエリパラメータを除いたもの）。 */
	canonical?: string;
	/** true でこのページを検索結果から除外する。 */
	noindex?: boolean;
}

const {
	title = 'ペンギンタイムカード — インストールしたその日から使える、やさしい勤怠管理',
	description = '小さなお店・会社のための、インストール不要のやさしい勤怠管理アプリ。ICカードも機械も不要。今すぐ無料で始められます。',
	canonical,
	noindex = false,
} = Astro.props;

// Astro.url.pathname だけを使うことで ?from=home / ?page=2 のような
// クエリ付きURLでも正規URLが1本に収束する。
const canonicalHref = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalHref} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<script is:inline>
			(function () {
				try {
					if (new URLSearchParams(window.location.search).get('noheader') === '1') {
						document.documentElement.classList.add('noheader');
					}
				} catch (e) {}
			})();
		</script>
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
		<style>
			/* tweak-driven utility classes */
			html.hide-mascot .mascot { display: none !important; }
			html.reduce-motion *, html.reduce-motion *::before, html.reduce-motion *::after {
				animation-duration: 0.001ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.001ms !important;
			}
		</style>
		<!-- ページ固有の head 要素（rel=prev/next、構造化データなど） -->
		<slot name="head" />
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-NZ5W1S0PZV"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-NZ5W1S0PZV');
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
