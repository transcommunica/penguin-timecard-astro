---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const pageTitle = '特定商取引法';
const pageDescription = 'ペンギンタイムカードの特定商取引法に基づく表示ページです。';
---

<Layout title={pageTitle} description={pageDescription}>
  <SiteHeader />

  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">ホーム</a>
        <span class="sep">/</span>
        <span class="here">特定商取引法</span>
      </div>
      <div class="hero-inner">
        <h1>特定商取引法に基づく表記</h1>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <article class="page-body">
        <table>
          <tbody>
            <tr>
              <th scope="row">法人名</th>
              <td>株式会社トランスコミュニカ</td>
            </tr>
            <tr>
              <th scope="row">所在地</th>
              <td>〒870-0921　大分県大分市萩原2-1-23</td>
            </tr>
            <tr>
              <th scope="row">電話番号</th>
              <td>097-594-2101</td>
            </tr>
            <tr>
              <th scope="row">メールアドレス</th>
              <td>timecard@transcommunica.com</td>
            </tr>
            <tr>
              <th scope="row">取締役</th>
              <td>山本譲治</td>
            </tr>
            <tr>
              <th scope="row">追加手数料</th>
              <td>銀行振込の場合は振込手数料</td>
            </tr>
            <tr>
              <th scope="row">交換および返品</th>
              <td>
                ソフトウェアのため交換返品はありません。<br />
                いつでも解約は可能です。支払った金額の対象期間終了までシステムを利用できます。返金対応は致しておりません。
              </td>
            </tr>
            <tr>
              <th scope="row">配達時間</th>
              <td>
                ソフトウェアのため配達はありません。<br />
                クレジットカードでのお支払い後、即時にご利用いただけます。
              </td>
            </tr>
            <tr>
              <th scope="row">受け付け可能な決済手段</th>
              <td>クレジットカードおよび銀行口座引き落とし</td>
            </tr>
            <tr>
              <th scope="row">決済期間</th>
              <td>
                クレジットカード決済の場合はただちに処理されます。<br />
                銀行口座引き落としの場合には、書類のやりとりや銀行側の処理を含めて３ヶ月程度かかります。
              </td>
            </tr>
            <tr>
              <th scope="row">値</th>
              <td>月額料金は2,000円からとなっております。</td>
            </tr>
            <tr>
              <th scope="row">動作環境</th>
              <td>
                iPhone, iPad, Android, Windowsおよび各種ブラウザーで動作します。<br />
                Apple社等の技術的制約により、古いバージョンのOSは順次使えなくなります。できるだけ最新のOSをご利用ください。
              </td>
            </tr>
          </tbody>
        </table>
      </article>
    </div>
  </section>

  <SiteFooter />
</Layout>

<style>
  .page-hero {
    padding: 30px 0 40px;
    border-bottom: 1px solid var(--line);
  }

  .page-hero .container,
  .page-section .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .breadcrumb {
    padding: 12px 0 8px;
    font-size: 13px;
    color: var(--ink-2);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .breadcrumb a { color: var(--ink-2); }
  .breadcrumb .sep { opacity: 0.5; }
  .breadcrumb .here { color: var(--ink); }

  .hero-inner h1 {
    margin: 16px 0 0;
    font-size: clamp(26px, 3.6vw, 40px);
  }

  .page-section {
    padding: 40px 0 80px;
  }

  .page-body {
    max-width: 1000px;
    margin: 0 auto;
    color: var(--ink);
    line-height: 1.9;
    font-size: 15px;
  }

  .page-body table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
    margin: 1.2em 0;
    font-size: 14px;
  }

  .page-body th,
  .page-body td {
    border: 1px solid var(--line);
    padding: 10px 12px;
    vertical-align: top;
    text-align: left;
  }

  .page-body th {
    background: rgba(0, 0, 0, 0.04);
    font-weight: 700;
    white-space: nowrap;
    width: 30%;
  }

  @media (max-width: 640px) {
    .page-section {
      padding: 28px 0 56px;
    }

    .page-body table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .page-body th {
      white-space: normal;
      width: auto;
    }
  }
</style>
