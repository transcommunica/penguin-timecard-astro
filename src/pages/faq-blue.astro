---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageCta from '../components/PageCta.astro';
import BreadcrumbJsonLd from '../components/BreadcrumbJsonLd.astro';

type FaqItem = {
  id: string;
  question: string;
  answerHtml: string;
};

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

const pageTitle = 'よくある質問';
const pageDescription = 'ペンギンタイムカード（ブルー版）のよくある質問ページです。';

// 質問と回答（旧サイトの掲載順）
const faqItems: FaqItem[] = [
  {
    id: 'faq1',
    question: '何が必要ですか？',
    answerHtml: 'iPhone/iPadのみです。あとはインターネット環境があれば開始できます。',
  },
  {
    id: 'faq2',
    question: 'インターネットが切れても使えますか？',
    answerHtml: 'はい、使えます。ただし、更新期日を過ぎるとアカウント認証エラーとなります。その際は、再度インターネットに接続してください。',
  },
  {
    id: 'faq3',
    question: '他の労務管理システムと連係できますか？',
    answerHtml: '現時点で連係機能はありません。必要な場合は、CSVファイルをメールで送信し、労務管理システムに取り込んでください。',
  },
  {
    id: 'faq4',
    question: '丸め処理はありますか？',
    answerHtml: 'はい、あります。10分単位、5分単位など、丸め計算設定ができます。「従業員タイプ」メニューから、該当の従業員タイプをタップして設定してください。',
  },
  {
    id: 'faq5',
    question: '何人まで利用できますか？',
    answerHtml: '15名まで2,200円（税込）、その後人数によって金額が変わります。大規模な施設でのご利用をご希望の方は<a href="/contact-us/">お問い合わせください</a>。ご相談に応じます。',
  },
  {
    id: 'faq6',
    question: '自動バックアップ機能とは？',
    answerHtml: '１日１回、データをサーバーに自動保存する機能です。万が一、iPhone/iPadが壊れてしまった場合などに、データを復元することができます。',
  },
  {
    id: 'faq7',
    question: 'メール送信機能とは？',
    answerHtml: 'ひと月の出退勤データをメールで送信できます。結果はPDFとCSV（エクセル）で送信されます。',
  },
  {
    id: 'faq8',
    question: '休憩管理もできますか ？',
    answerHtml: 'はい、できます。設定すると、休憩入り、休憩出ボタンが表示されます。正社員のように休憩時間が固定されている場合（例：１時間）は、ボタンを表示せず、自動計算することもできます。',
  },
  {
    id: 'faq9',
    question: '社労士へ送信できますか ？',
    answerHtml: 'はい、できます。メールの宛先に社労士様のメールアドレスを入れ、送信ボタンを押してください。',
  },
  {
    id: 'faq10',
    question: '正社員、パートで管理方法を分けたいのですが 。',
    answerHtml: '「正社員」「パート」など、従業員のタイプを設定できます。タイプごとに異なる「勤務時間」「休憩の管理有無」「丸め計算方法」などを設定できます。',
  },
  {
    id: 'faq11',
    question: '深夜残業は計算されますか？',
    answerHtml: '残業時間は自動計算されますが、金額計算はできません。また、通常残業と深夜残業の区別はできません。',
  },
  {
    id: 'faq12',
    question: '日付をまたいで働いた場合はどうなりますか？',
    answerHtml: '日付をまたいだ時間計算には対応しておりません。',
  },
  {
    id: 'faq13',
    question: '修正はできますか？',
    answerHtml: 'はい、できます。ただし、修正箇所は赤文字になります。管理者画面から見ると、タップした時間と修正時間の両方を確認できます。',
  },
  {
    id: 'faq14',
    question: 'ICカードなどは必要ですか ？',
    answerHtml: 'いいえ、不要です。シンプルなアプリを追求しており、iPhone/iPad以外の機械は不要です。',
  },
  {
    id: 'faq15',
    question: 'アプリを削除してもデータは残りますか？',
    answerHtml: 'いいえ、残りません。アプリを削除してしまうと、出退勤データも削除されてしまいますので、十分注意してください。データ喪失を防ぐために、自動バックアップをおすすめします。',
  },
  {
    id: 'faq16',
    question: 'iPhone/iPadが壊れたらどうなりますか ？',
    answerHtml: 'iPhone/iPadが壊れ、アプリにアクセスできなくなると、データも見れなくなってしまいます。 データ喪失を防ぐために、自動バックアップをおすすめします。',
  },
  {
    id: 'faq17',
    question: '新しいiPhone/iPadに変えたらどうしますか？',
    answerHtml: 'データをサーバーにバックアップし、新しいiPhone/iPadに復元できます。',
  },
  {
    id: 'faq18',
    question: 'どのiPhone/iPadに対応していますか？',
    answerHtml: '現在はiOS10.0以上のiPad, iPhoneに対応していますが、Apple社の制約により古いiOSへは徐々に対応できなくなっていきます。できるだけ新しい端末をおすすめします。',
  },
];

// JSON-LD 構造化データ
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.answerHtml),
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <BreadcrumbJsonLd
      items={[
        { name: 'ホーム', href: '/' },
        { name: 'よくある質問' },
      ]}
    />
  </Fragment>

  <SiteHeader active="faq" />


  <section class="faq-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">ホーム</a>
        <span class="sep">/</span>
        <span class="here">よくある質問</span>
      </div>
      <div class="hero-inner">
        <span class="eyebrow">FAQ</span>
        <h1>よくある質問</h1>
        <p class="lead">{faqItems.length}件の質問と回答を掲載しています。</p>
      </div>
      <div class="version-notice">
        こちらはブルー版のFAQです。
        オレンジ版のFAQは<a href="/faq/">こちら</a>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <dl class="faq-list">
        {faqItems.map((item, index) => (
          <div class="faq-item" id={item.id}>
            <dt class="faq-q">
              <button
                type="button"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls={`ans-${item.id}`}
              >
                <span class="q-badge">Q{String(index + 1).padStart(2, '0')}</span>
                <span class="q-text">{item.question}</span>
                <span class="q-icon" aria-hidden="true"></span>
              </button>
            </dt>
            <dd class="faq-a" id={`ans-${item.id}`} hidden>
              <div class="faq-a-inner" set:html={item.answerHtml}></div>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <PageCta
    eyebrow="CONTACT"
    title="解決しないときは、お気軽に"
    description="よくある質問で解決しない場合は、お問い合わせフォームからご相談ください。担当者から、できるだけ早くお返事します。"
    buttonText="お問い合わせフォーム"
    buttonHref="/contact-us/"
    meta="マニュアルもぜひご覧ください"
  />
  <SiteFooter />
</Layout>

<script>
  // アコーディオン
  document.querySelectorAll<HTMLButtonElement>('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answerId = btn.getAttribute('aria-controls');
      const answer = answerId ? document.getElementById(answerId) : null;

      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.faq-item')?.classList.toggle('open', !expanded);
      if (answer) {
        if (expanded) {
          answer.hidden = true;
        } else {
          answer.hidden = false;
        }
      }
    });
  });

  // reveal アニメーション
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

<style>
  .faq-hero {
    padding: 30px 0 44px;
    background:
      radial-gradient(ellipse 60% 40% at 86% 20%, rgba(243, 154, 45, 0.12), transparent 65%),
      radial-gradient(ellipse 45% 35% at 8% 88%, rgba(123, 200, 232, 0.15), transparent 65%);
  }

  .breadcrumb {
    padding: 12px 0 8px;
    font-size: 13px;
    color: var(--ink-2);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .breadcrumb a { color: var(--ink-2); }
  .breadcrumb .sep { opacity: 0.5; }
  .breadcrumb .here { color: var(--ink); }

  .hero-inner .eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.3em;
    color: var(--brand);
    display: block;
    margin-bottom: 10px;
  }

  .hero-inner h1 {
    margin: 0 0 12px;
    font-size: clamp(32px, 4.8vw, 52px);
  }

  .hero-inner .lead {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
  }

  .version-notice {
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-2);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 16px;
    display: inline-block;
  }

  .version-notice a {
    color: var(--brand-deep);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-section {
    padding: 40px 0 72px;
  }

  .faq-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 860px;
  }

  .faq-item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 0 var(--line);
    transition: box-shadow .2s;
  }

  .faq-item.open {
    box-shadow: 0 6px 0 var(--brand-soft);
    border-color: var(--brand-soft);
  }

  .faq-q {
    margin: 0;
  }

  .faq-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    text-align: left;
    background: none;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.5;
  }

  .faq-toggle:hover {
    background: rgba(243, 154, 45, 0.04);
  }

  .q-badge {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 800;
    color: var(--brand-deep);
    background: var(--brand-soft);
    border-radius: 999px;
    padding: 3px 10px;
    flex: none;
    letter-spacing: 0.06em;
  }

  .faq-item.open .q-badge {
    background: var(--brand);
    color: #fff;
  }

  .q-text {
    flex: 1;
  }

  .q-icon {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--line);
    position: relative;
    transition: border-color .2s, background .2s;
  }

  .q-icon::before,
  .q-icon::after {
    content: "";
    position: absolute;
    background: var(--ink-2);
    border-radius: 2px;
    transition: transform .25s, opacity .2s;
  }

  .q-icon::before {
    width: 10px;
    height: 2px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .q-icon::after {
    width: 2px;
    height: 10px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .faq-item.open .q-icon {
    border-color: var(--brand);
    background: var(--brand);
  }

  .faq-item.open .q-icon::before,
  .faq-item.open .q-icon::after {
    background: #fff;
  }

  .faq-item.open .q-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq-a {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .faq-a-inner {
    padding: 18px 20px 20px calc(20px + 14px + 44px);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink);
  }

  .faq-a-inner :global(a) {
    color: var(--brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-a-inner :global(p) {
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-toggle {
      gap: 10px;
      font-size: 15px;
    }

    .faq-a-inner {
      padding: 14px 16px 16px 16px;
    }
  }
</style>
