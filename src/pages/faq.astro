---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageCta from '../components/PageCta.astro';

type FaqItem = {
  id: string;
  question: string;
  answerHtml: string;
};

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

const pageTitle = 'よくある質問';
const pageDescription = 'ペンギンタイムカード（オレンジ版）のよくある質問ページです。';

// 質問と回答（旧サイトの掲載順）
const faqItems: FaqItem[] = [
  {
    id: 'faq-question-1641977379863',
    question: 'どのように使うのですか',
    answerHtml: 'オフィス・店舗などに１台おき、名前をタップして出勤、退勤を記録します。また、各個人のスマートフォンやパソコンで記録することもできます。',
  },
  {
    id: 'faq-question-1641978783564',
    question: '特徴はなんですか',
    answerHtml: 'タブレットやパソコン、スマートフォンがあれば、シンプルに誰でも始められることです。 時間集計、丸め計算などの必要な機能は充実しています。',
  },
  {
    id: 'faq-question-1641978887204',
    question: '何が必要ですか',
    answerHtml: 'パソコン、スマートフォン、タブレットいずれでも動作します。iPad, iPhone, アンドロイド端末、Windowsパソコンのいずれかがあればスタートできます。ブラウザー（エッジ、クロームなど）でも動作しますので、どんな端末でも動作します。',
  },
  {
    id: 'faq-question-1641978942762',
    question: 'どのような業種や使い方に向いていますか',
    answerHtml: '少人数から大規模まで幅広く対応できます。Google社の安定したサーバー技術により、人数に関係なく対応いたします。',
  },
  {
    id: 'faq-question-1641978986580',
    question: 'クラウドですか？',
    answerHtml: 'データはクラウドで管理されています。Google社のセキュリティによってお客様のデータは守りつつ、クラウドですのでどの端末からでもアクセスできる便利さもあります。',
  },
  {
    id: 'faq-question-1641979025856',
    question: '正社員、パート社員などにも対応していますか',
    answerHtml: '正社員、パート社員、契約社員など、異なる設定を「カテゴリー」として登録できます。異なる計算、締め日などを設定できます。',
  },
  {
    id: 'faq-question-1641979094744',
    question: '無料ですか',
    answerHtml: '料金プランがあります。詳しくは<a href="/rate-plan/">こちら</a>をご参照ください。',
  },
  {
    id: 'faq-question-1641979145130',
    question: '何人まで利用できますか',
    answerHtml: '特に人数制限はありません。50人以上でも数百人でも問題なくご利用いただけます。個別のお見積もりをご希望の方はお問い合わせフォームよりお気軽にお問い合わせください。',
  },
  {
    id: 'faq-question-1641979192244',
    question: '休憩の管理もできますか',
    answerHtml: 'はい、可能です。ボタンを押して休憩時間を計測するパターンと、「休憩は１時間」のように固定する場合と、両方対応しています。',
  },
  {
    id: 'faq-question-1641979278952',
    question: '解約はどのようにしたらよいですか',
    answerHtml: '管理画面右上のプロフィールアイコンをクリックし、画面一番下の「削除」からアカウントを削除してください。',
  },
  {
    id: 'faq-question-1641979395100',
    question: '大規模でも利用できますか',
    answerHtml: '数百人もしくはそれ以上でも対応可能です。機能追加・変更や、専用のサーバー領域を使うなど個別対応もできます。また、規模に合わせて別途お見積もりを作成いたしますのでお気軽にお問い合わせください。',
  },
  {
    id: 'faq-question-1641979501045',
    question: 'リモートワークや在宅ワークには対応していますか',
    answerHtml: 'はい、リモートワークや在宅ワークでもご利用いただけます。他のスタッフの情報が見れないように、スタッフごとのアカウントを作成できるようになっています。',
  },
  {
    id: 'faq-question-1641979894045',
    question: '丸めなどの計算はできますか',
    answerHtml: 'はい、切り上げ、切り捨て、〇〇分単位など、自由に設定が可能です。設定が難しい場合は遠隔での設定代行も行なっております。',
  },
  {
    id: 'faq-question-1646800764422',
    question: '休憩が複数回あるんですが対応できますか',
    answerHtml: 'はい、対応しています。１日最大３回まで休憩を記録できます。設定方法は<a href="/manual/multi-break/">複数回休憩</a>をご覧ください。３回以上の記録をご希望の場合は別途お問い合わせください。',
  },
  {
    id: 'faq-question-1646800779615',
    question: '複数の店舗で働く社員には対応していますか',
    answerHtml: 'はい、対応しています。たとえば、ある人がこの日はA店舗、次の日はB店舗というように働く場合も対応可能です。',
  },
  {
    id: 'faq-question-1646800790849',
    question: '店舗ごとにアカウントを作る必要がありますか',
    answerHtml: '店舗をまとめて見る人（管理者）、店舗ごとに見る人、というように権限を分けることができます。当アプリでは、各店舗を「オフィス」と呼び、それをまとめる単位を「オフィスグループ」と呼んでいます。①オーナー：全オフィスを見れます ②マネージャー：そのオフィスのみ見れます ③スタッフ：自分のデータのみ見れます ④表示・入力専用：そのオフィスのみ見れます。スタッフの追加などはできません',
  },
  {
    id: 'faq-question-1646800807630',
    question: '社員個人のスマートフォンやパソコンから入力できますか',
    answerHtml: 'はい、入力できます。「ユーザー一覧」メニューから「スタッフ」としてアカウントを発行してください。その社員は自分のデータのみ入力・閲覧ができます。',
  },
  {
    id: 'faq-question-1646800826099',
    question: '深夜残業は計算できますか',
    answerHtml: '「通常残業」と「深夜残業」のように分けて計算する機能はいまのところありません。将来的な開発予定に入っていますが、現時点では未定です。',
  },
  {
    id: 'faq-question-1646800837049',
    question: '日付をまたいだ夜勤などは対応していますか',
    answerHtml: '日付をまたいだ計算については対応予定です。リリース時期は未定ですが少々お待ちください。',
  },
  {
    id: 'faq-question-1646800848199',
    question: 'iPadなどが壊れたらデータはどうなりますか',
    answerHtml: 'データはGoogleのセキュリティによって守られたクラウドに管理されています。したがって、iPadやパソコンなどが壊れてもデータを紛失することはありません。',
  },
  {
    id: 'faq-question-1646800863152',
    question: '間違った場合などの修正はどうしますか',
    answerHtml: '勤怠表の該当部分をタップして手入力できます。ボタンをタップした時間と手入力した時間はきちんと分けて記録されます。',
  },
  {
    id: 'faq-question-1646800869339',
    question: '私（管理者）は店舗にいないのですが、店舗の担当者にID、パスワードを教えないといけないのですか',
    answerHtml: '管理者ID、パスワードを教えたくない場合は「表示・入力専用アカウント」をご利用ください。「ユーザー一覧」メニューから「表示・入力専用アカウント」を発行し、それを使って店舗の端末に設定してください。',
  },
  {
    id: 'faq-question-1646800881217',
    question: '入力し忘れた場合はどうなりますか',
    answerHtml: '手入力できるようになっています。スタッフ名をタップした後、右上の「詳細」をクリックします。該当に日時のデータを手入力してください。不正を防ぐため、「ボタンをタップしたのか」「手修正したのか」は分けて記録され、管理者は確認することができます。<br />手入力できる余地を残すことで、直行直帰の場合の対応や、入力忘れにも対応できます。',
  },
  {
    id: 'faq-question-1646800920532',
    question: 'どのバージョンの端末に対応していますか',
    answerHtml: '現時点ではiOS12.0以上のものに対応してますが、Apple社の制約により、古いiOSは徐々にサポートできなくなってきます。できるだけ新しい端末でのご利用をお勧めします。同様にAndroidもできるだけ新しいバージョンをお使いください。Windowsは現時点でWindows10、Windows11に対応しています。',
  },
  {
    id: 'faq-question-1646800936314',
    question: 'インターネットが切れても使えますか',
    answerHtml: '一時的にインターネットが切れていても管理画面などは動作しますが、出勤、退勤ボタンを押すためにはインターネット接続が必要です。',
  },
  {
    id: 'faq-question-1646800942126',
    question: '本人認証機能はありますか',
    answerHtml: '顔認証機能がございます。アプリの前に立つだけでどのスタッフかを判定します。<br />社員証などのカードの発行が不要で、オフィスに１台スマートフォンがあればスタートできるため、初期コストもランニングコストも抑えることができます。また、退職者の管理も容易になります。',
  },
  {
    id: 'faq-question-1646800958132',
    question: 'エクセルで開けますか',
    answerHtml: 'はい、PDFとエクセルにダウンロードできます。また、PDFとエクセルをメール送信することもできます。エクセルについては、今後列の追加・変更や複数回休憩機能ができるのに合わせて、列も増えたり減ったりするように改修中です。',
  },
  {
    id: 'faq-question-1646800964819',
    question: '他の労務システムと連携はありますか',
    answerHtml: '現時点で労務システムなどとの連携機能はありません。 必要に応じてエクセル（CSV）にダウンロードしていただき、加工して他システムに読み込ませていただくことになります。',
  },
];

// JSON-LD 構造化データ
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.answerHtml),
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription}>
  <SiteHeader />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <section class="faq-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">ホーム</a>
        <span class="sep">/</span>
        <span class="here">よくある質問</span>
      </div>
      <div class="hero-inner">
        <span class="eyebrow">FAQ</span>
        <h1>よくある質問</h1>
        <p class="lead">{faqItems.length}件の質問と回答を掲載しています。</p>
      </div>
      <div class="version-notice">
        こちらはオレンジ版のFAQです。
        ブルー版のFAQは<a href="/faq-blue/">こちら</a>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <dl class="faq-list">
        {faqItems.map((item, index) => (
          <div class="faq-item" id={item.id}>
            <dt class="faq-q">
              <button
                type="button"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls={`ans-${item.id}`}
              >
                <span class="q-badge">Q{String(index + 1).padStart(2, '0')}</span>
                <span class="q-text">{item.question}</span>
                <span class="q-icon" aria-hidden="true"></span>
              </button>
            </dt>
            <dd class="faq-a" id={`ans-${item.id}`} hidden>
              <div class="faq-a-inner" set:html={item.answerHtml}></div>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <PageCta
    eyebrow="CONTACT"
    title="解決しないときは、お気軽に"
    description="よくある質問で解決しない場合は、お問い合わせフォームからご相談ください。担当者から、できるだけ早くお返事します。"
    buttonText="お問い合わせフォーム"
    buttonHref="/contact-us/"
    meta="マニュアルもぜひご覧ください"
  />
  <SiteFooter />
</Layout>

<script>
  // アコーディオン
  document.querySelectorAll<HTMLButtonElement>('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answerId = btn.getAttribute('aria-controls');
      const answer = answerId ? document.getElementById(answerId) : null;

      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.faq-item')?.classList.toggle('open', !expanded);
      if (answer) {
        if (expanded) {
          answer.hidden = true;
        } else {
          answer.hidden = false;
        }
      }
    });
  });

  // reveal アニメーション
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>

<style>
  .faq-hero {
    padding: 30px 0 44px;
    background:
      radial-gradient(ellipse 60% 40% at 86% 20%, rgba(243, 154, 45, 0.12), transparent 65%),
      radial-gradient(ellipse 45% 35% at 8% 88%, rgba(123, 200, 232, 0.15), transparent 65%);
  }

  .breadcrumb {
    padding: 12px 0 8px;
    font-size: 13px;
    color: var(--ink-2);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .breadcrumb a { color: var(--ink-2); }
  .breadcrumb .sep { opacity: 0.5; }
  .breadcrumb .here { color: var(--ink); }

  .hero-inner .eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.3em;
    color: var(--brand);
    display: block;
    margin-bottom: 10px;
  }

  .hero-inner h1 {
    margin: 0 0 12px;
    font-size: clamp(32px, 4.8vw, 52px);
  }

  .hero-inner .lead {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
  }

  .version-notice {
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-2);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 16px;
    display: inline-block;
  }

  .version-notice a {
    color: var(--brand-deep);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-section {
    padding: 40px 0 72px;
  }

  .faq-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 860px;
  }

  .faq-item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 0 var(--line);
    transition: box-shadow .2s;
  }

  .faq-item.open {
    box-shadow: 0 6px 0 var(--brand-soft);
    border-color: var(--brand-soft);
  }

  .faq-q {
    margin: 0;
  }

  .faq-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    text-align: left;
    background: none;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.5;
  }

  .faq-toggle:hover {
    background: rgba(243, 154, 45, 0.04);
  }

  .q-badge {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 800;
    color: var(--brand-deep);
    background: var(--brand-soft);
    border-radius: 999px;
    padding: 3px 10px;
    flex: none;
    letter-spacing: 0.06em;
  }

  .faq-item.open .q-badge {
    background: var(--brand);
    color: #fff;
  }

  .q-text {
    flex: 1;
  }

  .q-icon {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--line);
    position: relative;
    transition: border-color .2s, background .2s;
  }

  .q-icon::before,
  .q-icon::after {
    content: "";
    position: absolute;
    background: var(--ink-2);
    border-radius: 2px;
    transition: transform .25s, opacity .2s;
  }

  .q-icon::before {
    width: 10px;
    height: 2px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .q-icon::after {
    width: 2px;
    height: 10px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .faq-item.open .q-icon {
    border-color: var(--brand);
    background: var(--brand);
  }

  .faq-item.open .q-icon::before,
  .faq-item.open .q-icon::after {
    background: #fff;
  }

  .faq-item.open .q-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq-a {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .faq-a-inner {
    padding: 18px 20px 20px calc(20px + 14px + 44px);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink);
  }

  .faq-a-inner :global(a) {
    color: var(--brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-a-inner :global(p) {
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-toggle {
      gap: 10px;
      font-size: 15px;
    }

    .faq-a-inner {
      padding: 14px 16px 16px 16px;
    }
  }
</style>
